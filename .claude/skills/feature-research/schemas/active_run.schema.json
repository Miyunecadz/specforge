{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-research.local/schemas/active_run.schema.json",
  "title": "<runs-root>/.active_run (BUILD_SPEC §11.3). Written only by run_state.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "mode", "fixture_dir", "session_id", "started_at", "resumed_at"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "run_id": { "$ref": "common.schema.json#/$defs/run_id" },
    "mode": { "$ref": "common.schema.json#/$defs/run_mode" },
    "fixture_dir": { "type": ["string", "null"] },
    "session_id": { "$ref": "common.schema.json#/$defs/session_id" },
    "started_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "resumed_at": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/timestamp" }] }
  }
}
