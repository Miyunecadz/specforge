{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-research.local/schemas/change.schema.json",
  "title": "input/change-<n>.json, written only by run_state.py change-inputs: change-impact analysis result (§15). Applied by status_rules.py apply.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "change_id",
    "created_at",
    "input",
    "old_sha256",
    "new_sha256",
    "changed_req_ids",
    "added_text",
    "stale_items"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "change_id": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "input": {
      "enum": [
        "requirements"
      ]
    },
    "reason": {
      "type": "string"
    },
    "old_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "new_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "changed_req_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/req_id"
      }
    },
    "added_text": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "sentences in the new version not quoted by any requirement"
    },
    "stale_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "stale_reason"
        ],
        "properties": {
          "item_id": {
            "$ref": "common.schema.json#/$defs/tracked_item_id"
          },
          "stale_reason": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          }
        }
      }
    }
  }
}
