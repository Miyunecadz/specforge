            "properties": {
              "type": {
                "enum": [
                  "approve",
                  "reject",
                  "defer",
                  "reopen",
                  "supersede",
                  "reconfirm",
                  "leave_open",
                  "clear_issue",
                  "create_requirement",
                  "create_gap",
                  "set_priority",
                  "set_resolution_path",
                  "set_research_questions"
                ]
              },
              "item_id": {
                "$ref": "common.schema.json#/$defs/tracked_item_id"
              },
              "issue": {
                "$ref": "common.schema.json#/$defs/issue"
              },
              "statement": {
                "$ref": "common.schema.json#/$defs/nonempty_string"
              },
              "req_type": {
                "enum": [
                  "functional",
