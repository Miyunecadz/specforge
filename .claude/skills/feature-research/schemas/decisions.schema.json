                }
              },
              "replacement_id": {
                "$ref": "common.schema.json#/$defs/tracked_item_id"
              }
            }
          }
        },
        "created_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
