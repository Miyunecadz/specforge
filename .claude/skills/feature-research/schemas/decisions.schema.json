            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/tracked_item_id"
              },
              "kind": {
                "$ref": "common.schema.json#/$defs/kind"
              },
              "statement": {
                "$ref": "common.schema.json#/$defs/nonempty_string"
              },
              "req_type": {
                "type": "string"
              },
              "priority": {
                "type": "string"
              },
              "title": {
                "$ref": "common.schema.json#/$defs/nonempty_string"
              },
              "description": {
                "$ref": "common.schema.json#/$defs/nonempty_string"
              },
              "resolution_path": {
                "enum": [
                  "research",
                  "customer",
                  "both"
                ]
              },
              "research_questions": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/nonempty_string"
                }
              }
            }
          }
        },
        "timestamp": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/dec_id"
            }
          ]
        },
        "superseded_by": {
          "anyOf": [
