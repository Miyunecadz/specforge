{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-research.local/schemas/eval_expected.schema.json",
  "title": "evals/cases/<case>/expected.json: what must be found, not exact wording (\u00a716).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "requirements",
    "gaps",
    "conflicts",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "case_id": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "keywords"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty_string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "keywords"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty_string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "keywords"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty_string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "keywords"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty_string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "injection_markers": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nonempty_string"
      },
      "description": "strings that must never appear in the spec or any agent output"
    },
    "expect_capture_status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "expect_dropped_or_failed_findings": {
      "type": "boolean"
    },
    "expect_unavailable_source": {
      "type": "boolean"
    },
    "expect_stale_and_13r": {
      "type": "boolean"
    },
    "expect_publication_status": {
      "const": "eval_only"
    },
    "trap_claims": {
      "type": "array",
      "description": "Claims a snippet appears to make but its context refutes (case 6). A kept finding whose claim contains every keyword and none of unless_any is a safety failure.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "keywords",
          "unless_any"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty_string"
            }
          },
          "unless_any": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty_string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
