{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-research.local/schemas/feasibility.schema.json",
  "title": "feasibility.json, written only by feasibility-analyst (§9.9). The classification-to-provenance/kind mapping is enforced here and by status_rules.py register.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "items",
    "new_unknowns",
    "assumptions",
    "proposed_status_changes",
    "inspected_documents"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "area",
          "description",
          "classification",
          "related_ids",
          "evidence_refs",
          "uncertainties",
          "provenance",
          "kind"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/fea_id"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "area": {
            "enum": [
              "roles_and_permissions",
              "authentication_and_authorisation",
              "data_ownership_and_visibility",
              "validation_and_errors",
              "data_integrity_and_concurrency",
              "auditability",
              "notifications",
              "privacy_consent_retention",
              "accessibility_and_responsiveness",
              "performance_and_scale",
              "integrations",
              "failure_recovery_and_retries",
              "migration_and_compatibility",
              "monitoring_and_support",
              "other"
            ]
          },
          "description": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "classification": {
            "enum": [
              "required_by_customer",
              "supported_by_evidence",
              "recommended_for_consideration",
              "undecided"
            ],
            "description": "Exactly one; required (§9.9)."
          },
          "related_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/any_item_id"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/evidence_ref"
            }
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty_string"
            },
            "description": "Integration points or constraints that inspection did not establish."
          },
          "provenance": {
            "enum": [
              "customer_requirement",
              "research_evidence",
              "inference"
            ]
          },
          "kind": {
            "enum": [
              "finding",
              "recommendation"
            ]
          }
        },
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/no_status_fields"
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "required_by_customer"
                }
              }
            },
            "then": {
              "properties": {
                "provenance": {
                  "const": "customer_requirement"
                },
                "kind": {
                  "const": "finding"
                },
                "related_ids": {
                  "contains": {
                    "type": "string",
                    "pattern": "^REQ-[0-9]{3,}$"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "supported_by_evidence"
                }
              }
            },
            "then": {
              "properties": {
                "provenance": {
                  "const": "research_evidence"
                },
                "kind": {
                  "const": "finding"
                },
                "related_ids": {
                  "contains": {
                    "type": "string",
                    "pattern": "^F-GAP-[0-9]{3,}-[0-9]{2,}$"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "recommended_for_consideration"
                }
              }
            },
            "then": {
              "properties": {
                "provenance": {
                  "const": "inference"
                },
                "kind": {
                  "const": "recommendation"
                },
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "undecided"
                }
              }
            },
            "then": {
              "properties": {
                "provenance": {
                  "const": "inference"
                },
                "kind": {
                  "const": "finding"
                },
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "new_unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "why_it_matters",
          "related_ids"
        ],
        "properties": {
          "question": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "why_it_matters": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "related_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/any_item_id"
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "why",
          "impact",
          "to_confirm",
          "provenance",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ASM-F-[0-9]{3,}$"
          },
          "text": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "why": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "impact": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "to_confirm": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "provenance": {
            "const": "assumption"
          },
          "kind": {
            "const": "assumption"
          },
          "related_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/any_item_id"
            }
          }
        }
      }
    },
    "proposed_status_changes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/proposed_status_change"
      }
    },
    "inspected_documents": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nonempty_string"
      },
      "description": "Repository or supplied documents actually read; empty means no existing architecture was established."
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "area",
        "description",
        "classification",
        "related_ids",
        "evidence_refs",
        "uncertainties",
        "provenance",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/fea_id"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/nonempty_string"
        },
        "area": {
          "enum": [
            "roles_and_permissions",
            "authentication_and_authorisation",
            "data_ownership_and_visibility",
            "validation_and_errors",
            "data_integrity_and_concurrency",
            "auditability",
            "notifications",
            "privacy_consent_retention",
            "accessibility_and_responsiveness",
            "performance_and_scale",
            "integrations",
            "failure_recovery_and_retries",
            "migration_and_compatibility",
            "monitoring_and_support",
            "other"
          ]
        },
        "description": {
          "$ref": "common.schema.json#/$defs/nonempty_string"
        },
        "classification": {
          "enum": [
            "required_by_customer",
            "supported_by_evidence",
            "recommended_for_consideration",
            "undecided"
          ],
          "description": "Exactly one; required (§9.9)."
        },
        "related_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/any_item_id"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidence_ref"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "description": "Integration points or constraints that inspection did not establish."
        },
        "provenance": {
          "enum": [
            "customer_requirement",
            "research_evidence",
            "inference"
          ]
        },
        "kind": {
          "enum": [
            "finding",
            "recommendation"
          ]
        }
      },
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/no_status_fields"
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "required_by_customer"
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "const": "customer_requirement"
              },
              "kind": {
                "const": "finding"
              },
              "related_ids": {
                "contains": {
                  "type": "string",
                  "pattern": "^REQ-[0-9]{3,}$"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "supported_by_evidence"
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "const": "research_evidence"
              },
              "kind": {
                "const": "finding"
              },
              "related_ids": {
                "contains": {
                  "type": "string",
                  "pattern": "^F-GAP-[0-9]{3,}-[0-9]{2,}$"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "recommended_for_consideration"
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "const": "inference"
              },
              "kind": {
                "const": "recommendation"
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "undecided"
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "const": "inference"
              },
              "kind": {
                "const": "finding"
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
