{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-research.local/schemas/fetch_request.schema.json",
  "title": "fetch_requests/<gap>.json, written only by web-researcher-fallback (§9.6 fallback mode).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "gap_id",
    "requests"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "gap_id": {
      "$ref": "common.schema.json#/$defs/gap_id"
    },
    "requests": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "why"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "why": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "research_question": {
            "type": "string"
          }
        }
      }
    }
  }
}
