{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-research.local/schemas/figma_recording.schema.json",
  "title": "Recorded Figma REST responses (*.figma.json), replayed offline in fixture mode and tests (Phase 1b addition).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "figma_url",
    "responses"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "description": {
      "type": "string"
    },
    "figma_url": {
      "type": "string",
      "pattern": "^https://(www\\.)?figma\\.com/(file|design|proto|board)/"
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "status"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "body_json": {
            "type": [
              "object",
              "array"
            ]
          },
          "body_file": {
            "$ref": "common.schema.json#/$defs/rel_path"
          }
        },
        "not": {
          "required": [
            "body_json",
            "body_file"
          ]
        }
      }
    }
  }
}
