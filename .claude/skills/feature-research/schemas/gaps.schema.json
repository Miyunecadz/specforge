{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-research.local/schemas/gaps.schema.json",
  "title": "gaps.json (§9.4). Written only by gap-analyst.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "gaps",
    "assumptions",
    "proposed_status_changes"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "category",
          "reason",
          "related_req_ids",
          "related_scr_ids",
          "evidence_refs",
          "basis",
          "why_it_matters",
          "consequences_if_unresolved",
          "resolution_path",
          "priority",
          "research_questions",
          "provenance",
          "kind"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/gap_id"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "category": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "reason": {
            "enum": [
              "requirement_uncovered",
              "checklist",
              "flow_issue",
              "ambiguous_behaviour",
              "conflict",
              "risk"
            ]
          },
          "related_req_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/req_id"
            }
          },
          "related_scr_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/scr_id"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/evidence_ref"
            }
          },
          "basis": {
            "enum": [
              "confirmed_requirement",
              "observed_limitation",
              "inference",
              "general_risk"
            ]
          },
          "checklist_item": {
            "type": "string"
          },
          "why_it_matters": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "consequences_if_unresolved": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "resolution_path": {
            "enum": [
              "research",
              "customer",
              "both"
            ]
          },
          "priority": {
            "enum": [
              "critical",
              "important",
              "optional"
            ]
          },
          "research_questions": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty_string"
            }
          },
          "provenance": {
            "enum": [
              "inference",
              "mockup_observation"
            ]
          },
          "kind": {
            "const": "gap"
          }
        },
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/no_status_fields"
          },
          {
            "if": {
              "properties": {
                "resolution_path": {
                  "const": "customer"
                }
              }
            },
            "then": {
              "properties": {
                "research_questions": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "research_questions": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "why",
          "impact",
          "to_confirm",
          "provenance",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ASM-G-[0-9]{3,}$"
          },
          "text": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "why": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "impact": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "to_confirm": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "provenance": {
            "const": "assumption"
          },
          "kind": {
            "const": "assumption"
          },
          "related_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/any_item_id"
            }
          }
        }
      }
    },
    "proposed_status_changes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/proposed_status_change"
      }
    }
  }
}
