{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-research.local/schemas/questions.schema.json",
  "title": "questions.json, written only by question-generator (§9.10).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "questions",
    "implementation_details"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "questions": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "why_it_matters",
          "affected_ids",
          "topic_keywords",
          "options",
          "recommendation",
          "blocking",
          "priority"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/q_id"
          },
          "question": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "why_it_matters": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "affected_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/any_item_id"
            }
          },
          "topic_keywords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty_string"
            }
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "option",
                "trade_offs"
              ],
              "properties": {
                "option": {
                  "$ref": "common.schema.json#/$defs/nonempty_string"
                },
                "trade_offs": {
                  "$ref": "common.schema.json#/$defs/nonempty_string"
                }
              }
            }
          },
          "recommendation": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "option",
                  "finding_ids",
                  "rationale"
                ],
                "properties": {
                  "option": {
                    "$ref": "common.schema.json#/$defs/nonempty_string"
                  },
                  "finding_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "common.schema.json#/$defs/finding_id"
                    }
                  },
                  "rationale": {
                    "$ref": "common.schema.json#/$defs/nonempty_string"
                  }
                }
              }
            ],
            "description": "Only when backed by a kept finding, cited."
          },
          "blocking": {
            "type": "boolean"
          },
          "priority": {
            "enum": [
              "critical",
              "important",
              "optional"
            ]
          }
        }
      }
    },
    "implementation_details": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "related_ids"
        ],
        "properties": {
          "item": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "related_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/any_item_id"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "why_it_matters",
        "affected_ids",
        "topic_keywords",
        "options",
        "recommendation",
        "blocking",
        "priority"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/q_id"
        },
        "question": {
          "$ref": "common.schema.json#/$defs/nonempty_string"
        },
        "why_it_matters": {
          "$ref": "common.schema.json#/$defs/nonempty_string"
        },
        "affected_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/any_item_id"
          }
        },
        "topic_keywords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option",
              "trade_offs"
            ],
            "properties": {
              "option": {
                "$ref": "common.schema.json#/$defs/nonempty_string"
              },
              "trade_offs": {
                "$ref": "common.schema.json#/$defs/nonempty_string"
              }
            }
          }
        },
        "recommendation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "option",
                "finding_ids",
                "rationale"
              ],
              "properties": {
                "option": {
                  "$ref": "common.schema.json#/$defs/nonempty_string"
                },
                "finding_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "common.schema.json#/$defs/finding_id"
                  }
                },
                "rationale": {
                  "$ref": "common.schema.json#/$defs/nonempty_string"
                }
              }
            }
          ],
          "description": "Only when backed by a kept finding, cited."
        },
        "blocking": {
          "type": "boolean"
        },
        "priority": {
          "enum": [
            "critical",
            "important",
            "optional"
          ]
        }
      }
    }
  }
}
