{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-research.local/schemas/validation.schema.json",
  "title": "validation.json, written only by check_spec.py (§9.13 [code] items).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "checked_at",
    "round",
    "mode",
    "items",
    "blocking_failures",
    "warning_failures",
    "passed"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "checked_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "full",
        "final"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "severity",
          "status",
          "evidence"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 21
          },
          "severity": {
            "enum": [
              "blocking",
              "warning"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_applicable"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "blocking_failures": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "warning_failures": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "passed": {
      "type": "boolean"
    }
  }
}
