{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-research.local/schemas/verified_findings.schema.json",
  "title": "verified_findings.json, written only by source-verifier (§9.8).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "kept",
    "dropped",
    "contradictions",
    "proposed_status_changes"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "kept": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "notes",
          "limitations"
        ],
        "properties": {
          "finding_id": {
            "$ref": "common.schema.json#/$defs/finding_id"
          },
          "notes": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty_string"
            }
          }
        }
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "reasons"
        ],
        "properties": {
          "finding_id": {
            "$ref": "common.schema.json#/$defs/finding_id"
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "explanation"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "snippet_does_not_support_claim",
                    "missing_context",
                    "overstates_source",
                    "not_credible_or_current",
                    "recommendation_not_reasonable",
                    "adds_assumptions",
                    "contradicted_by_stronger_source",
                    "not_relevant_to_gap"
                  ]
                },
                "explanation": {
                  "$ref": "common.schema.json#/$defs/nonempty_string"
                }
              }
            }
          }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_ids",
          "description"
        ],
        "properties": {
          "finding_ids": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "common.schema.json#/$defs/finding_id"
            }
          },
          "description": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          }
        }
      }
    },
    "proposed_status_changes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/proposed_status_change"
      }
    }
  }
}
