{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-research.local/schemas/warnings.schema.json",
  "title": "warnings/<agent-name>.json (one agent) and warnings.json (merged by run_state.py)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent", "warnings"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "agent": {
      "description": "The writing agent's name, or 'merged' for warnings.json.",
      "anyOf": [{ "$ref": "common.schema.json#/$defs/agent_name" }, { "const": "merged" }]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "enum": ["prompt_injection_attempt", "missing_input", "limitation", "unreadable_artifact", "other"] },
          "message": { "$ref": "common.schema.json#/$defs/nonempty_string" },
          "agent": { "$ref": "common.schema.json#/$defs/agent_name" },
          "evidence_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidence_ref" } }
        }
      }
    }
  }
}
